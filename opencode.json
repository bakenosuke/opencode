{
    "$schema": "https://opencode.ai/config.json",
    "theme": "opencode",
    "autoupdate": true,
    "model": "github-copilot/claude-sonnet-4.5",
    "small_model": "github-copilot/gpt-5-mini",
    "mcp": {
        "github" :{
            "type": "remote",
            "url": "https://api.githubcopilot.mcp",
            "enabled": false,
            "headers": {
                "Authorization": "Bearer {env:github_mcp_pat}"
            },
            "timeout": 60000
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "--yes",
                "@playwright/mcp@latest"
            ],
            "enabled": false,
            "timeout": 60000
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": false,
            "timeout": 60000
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app",
            "enabled": false,
            "timeout": 60000
        }
    },
    "plugin": [
        "@ramtinj95/opencode-tokenscope@latest"
    ]
}